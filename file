    /**
     * Добавить правило в Outbound Strategy: if sender_domain == 'domain' then 'strategy'.
     */
    public function addOutboundRule(string $domain, string $strategyName): bool
    {
        $outbound = $this->getOutboundStrategy();

        $existingMatch = [];
        if ($outbound && !empty($outbound['connection']['match'])) {
            foreach ($outbound['connection']['match'] as $rule) {
                $existingMatch[] = $rule;
            }
        }

        // Убираем старые правила для этого домена (если есть)
        $filteredMatch = [];
        foreach ($existingMatch as $rule) {
            $ifExpr = $rule['if'] ?? '';
            if (strpos($ifExpr, "'{$domain}'") !== false) {
                continue;
            }
            $filteredMatch[] = $rule;
        }

        // Добавляем новое правило
        $newRule = new stdClass();
        $newRule->if = "sender_domain == '{$domain}'";
        $newRule->then = "'{$strategyName}'";

        $matchObj = new stdClass();
        $i = 0;
        foreach ($filteredMatch as $rule) {
            $obj = new stdClass();
            foreach ($rule as $k => $v) {
                $obj->{$k} = $v;
            }
            $matchObj->{(string)$i} = $obj;
            $i++;
        }
        $matchObj->{(string)$i} = $newRule;

        $newConnection = new stdClass();
        $newConnection->match = $matchObj;
        $newConnection->else = $outbound['connection']['else'] ?? "'default'";

        $update = new stdClass();
        $patch = new stdClass();
        $patch->connection = $newConnection;
        $update->{'singleton'} = $patch;

        $response = $this->request([
            ['x:MtaOutboundStrategy/set', ['update' => $update], 'c1']
        ]);

        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:MtaOutboundStrategy/set') {
                if (isset($method[1]['notUpdated']['singleton'])) {
                    throw new Exception("Ошибка обновления Outbound Strategy: " . json_encode($method[1]['notUpdated']['singleton']));
                }
                return true;
            }
        }
        return false;
    }

