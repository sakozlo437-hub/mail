<?php

class DomainService
{
    public static function create(int $serverId, string $domainName, bool $generateDkim = true, string $attachIp = '', string $ehlo = '', string $extraSan = ''): array
    {
        if (!$domainName) {
            throw new Exception('Введите имя домена');
        }
        $server = Database::getServer($serverId);
        if (!$server) {
            throw new Exception('Сервер не найден');
        }

        $client = new StalwartClient($server['api_url'], $server['api_user'], $server['api_password']);
        $domainId = $client->createDomain($domainName);
        if (!$domainId) {
            throw new Exception('Не удалось создать домен');
        }

        $log = ["Домен $domainName создан (ID: $domainId)"];

        // 1. Создаём ящик postmaster@домен (нужен для ACME contact)
        try {
            $client->createAccount('postmaster', $domainId, bin2hex(random_bytes(16)));
            $log[] = "Ящик postmaster@$domainName создан";
        } catch (Exception $e) {
            $log[] = "postmaster ошибка: " . $e->getMessage();
        }

        // 2. DKIM: Stalwart создаёт автоматически при создании домена.
        // Нам не нужно создавать свои — иначе будет дублирование.
        $log[] = "DKIM создан автоматически Stalwart";

        // 3. Привязываем домен к существующему ACME-провайдеру
        try {
            $providers = $client->getAcmeProviders();
            if (empty($providers)) {
                throw new Exception('Нет ни одного ACME-провайдера. Создайте в WebAdmin: Settings → TLS → ACME Providers');
            }

            // Берём первый провайдер (обычно Let's Encrypt)
            $acmeId = $providers[0]['id'];
            $log[] = "Используем ACME-провайдер: $acmeId";

            $sanList = [$domainName, 'mail.' . $domainName];
            if ($extraSan) {
                $sanList[] = trim($extraSan);
            }
            $client->attachDomainToAcme($domainId, $acmeId, $sanList);
            $log[] = "Домен привязан к ACME (SAN: " . implode(', ', $sanList) . ")";
        } catch (Exception $e) {
            $log[] = "ACME ошибка: " . $e->getMessage();
        }

        // 4. Привязываем к IP
        if ($attachIp) {
            try {
                if (!$ehlo) {
                    $ehlo = 'mail.' . $domainName;
                }
                $strategyName = 'ipv6-for-' . str_replace('.', '-', $domainName);
                $strategyId = $client->createConnectionStrategy($strategyName, $ehlo, $attachIp);
                $log[] = "Стратегия $strategyName создана (ID: $strategyId)";

                $client->addOutboundRule($domainName, $strategyName);
                $log[] = "Правило для $domainName → $strategyName добавлено";
            } catch (Exception $e) {
                $log[] = "Стратегия ошибка: " . $e->getMessage();
            }
        }

        return $log;
    }

    public static function listByServer(int $serverId): array
    {
        $server = Database::getServer($serverId);
        if (!$server) {
            throw new Exception('Сервер не найден');
        }
        $client = new StalwartClient($server['api_url'], $server['api_user'], $server['api_password']);
        return $client->getDomains();
    }

    public static function delete(int $serverId, string $domainId): array
    {
        if (!$domainId) {
            throw new Exception('Не указан ID домена');
        }
        $server = Database::getServer($serverId);
        if (!$server) {
            throw new Exception('Сервер не найден');
        }
        $client = new StalwartClient($server['api_url'], $server['api_user'], $server['api_password']);

        $log = [];

        // Получаем имя домена
        $domains = $client->getDomains();
        $domainName = '';
        foreach ($domains as $name => $id) {
            if ($id === $domainId) {
                $domainName = $name;
                break;
            }
        }

        // 1. Удаляем правило из Outbound Strategy
        if ($domainName) {
            try {
                $client->removeOutboundRuleByDomain($domainName);
                $log[] = "Правило для $domainName удалено из Outbound Strategy";
            } catch (Exception $e) {
                $log[] = "Outbound ошибка: " . $e->getMessage();
            }
        }

        // 2. Удаляем Connection Strategy
        if ($domainName) {
            try {
                $strategyName = 'ipv6-for-' . str_replace('.', '-', $domainName);
                $strategy = $client->findStrategyByName($strategyName);
                if ($strategy) {
                    $client->deleteConnectionStrategy($strategy['id']);
                    $log[] = "Стратегия $strategyName удалена";
                }
            } catch (Exception $e) {
                $log[] = "Стратегия ошибка: " . $e->getMessage();
            }
        }

        // 3. Удаляем DKIM-подписи
        $dkimList = $client->getDkimSignatures();
        foreach ($dkimList as $sig) {
            if ($sig['domainId'] === $domainId) {
                try {
                    $client->deleteDkimSignature($sig['id']);
                    $log[] = "Удалена DKIM: {$sig['selector']}";
                } catch (Exception $e) {
                    $log[] = "DKIM ошибка: " . $e->getMessage();
                }
            }
        }

        // 4. Удаляем аккаунты
        $accounts = $client->getAccounts();
        foreach ($accounts as $acc) {
            if ($acc['domainId'] === $domainId) {
                try {
                    $client->deleteAccount($acc['id']);
                    $log[] = "Удалён ящик: {$acc['name']}";
                } catch (Exception $e) {
                    $log[] = "Ящик ошибка: " . $e->getMessage();
                }
            }
        }

        // 5. Удаляем сертификаты
        if ($domainName) {
            $certs = $client->getCertificates();
            foreach ($certs as $cert) {
                $sanList = $cert['subjectAlternativeNames'];
                $match = false;
                foreach ($sanList as $san) {
                    if ($san === $domainName || $san === 'mail.' . $domainName) {
                        $match = true;
                        break;
                    }
                }
                if ($match) {
                    try {
                        $client->unlinkCertificateFromDefaults($cert['id']);
                        $client->deleteCertificate($cert['id']);
                        $log[] = "Удалён сертификат: " . implode(', ', $sanList);
                    } catch (Exception $e) {
                        $log[] = "Сертификат ошибка: " . $e->getMessage();
                    }
                }
            }
        }

        // 6. Удаляем ACME-провайдер, если он был создан для этого домена
        if ($domainName) {
            try {
                $providerName = 'letsencrypt-' . str_replace('.', '-', $domainName);
                // ACME-провайдеры не имеют метода поиска по имени — ищем через get
                // Пока просто логируем, что нужно удалить вручную
                $log[] = "ACME-провайдер $providerName — проверь вручную (Settings → TLS → ACME Providers)";
            } catch (Exception $e) {
                // ignore
            }
        }

        // 7. Удаляем сам домен
        try {
            $client->deleteDomain($domainId);
            $log[] = "Домен удалён";
        } catch (Exception $e) {
            throw new Exception("Ошибка удаления домена: " . $e->getMessage() . " | Лог: " . implode('; ', $log));
        }

        return $log;
    }
}


