     */
    public static function getNetplanIps(int $serverId): array
    {
        $server = Database::getServer($serverId);
        if (!$server || empty($server['ssh_host'])) {
            return [];
        }
        try {
            $ssh = new SshClient(
                $server['ssh_host'],
                (int)$server['ssh_port'],
                $server['ssh_user'],
                $server['ssh_password']
            );
            $ssh->connect();
            return $ssh->getNetplanIps('eth0');
        } catch (Exception $e) {
            return ['_error' => $e->getMessage()];
        }
    }

    /**
     * Удалить IP из Connection Strategy.
     */
    public static function removeIpFromStrategy(int $serverId, string $strategyId, string $ip): array
    {
        $server = Database::getServer($serverId);
        if (!$server) throw new Exception('Сервер не найден');
        $client = new StalwartClient($server['api_url'], $server['api_user'], $server['api_password']);

        $log = [];

        // 1. Убираем IP из стратегии
        $client->removeIpFromConnectionStrategy($strategyId, $ip);
        $log[] = "IP удалён из sourceIps";

        // 2. Проверяем, остались ли IP в стратегии
        $strategies = $client->getConnectionStrategies();
        $strategy = null;
        foreach ($strategies as $st) {
            if ($st['id'] === $strategyId) {
                $strategy = $st;
                break;
            }
        }

        if ($strategy && empty($strategy['sourceIps'])) {
            // 3. Удаляем правило из Outbound Strategy (если было)
            try {
                $client->removeOutboundRule($strategy['name']);
                $log[] = "Правило в Outbound Strategy удалено";
            } catch (Exception $e) {
                $log[] = "Outbound: " . $e->getMessage();
            }

            // 4. Удаляем саму стратегию
            $client->deleteConnectionStrategy($strategyId);
            $log[] = "Стратегия удалена";
        }

        return $log;
    }

    public static function setupSsh(int $serverId, string $sshHost, int $sshPort, string $sshUser, string $sshPassword): array
    {
        $server = Database::getServer($serverId);
        if (!$server) throw new Exception('Сервер не найден');
        if (!$sshHost || !$sshPassword) throw new Exception('Заполните SSH Host и пароль');

        $pdo = Database::get();
        $stmt = $pdo->prepare("UPDATE servers SET ssh_host=?, ssh_port=?, ssh_user=?, ssh_password=?, ssh_configured=FALSE WHERE id=?");
        $stmt->execute([$sshHost, $sshPort, $sshUser, $sshPassword, $serverId]);

        $ssh = new SshClient($sshHost, $sshPort, $sshUser, $sshPassword);
        $ssh->connect();

        $pyResult = $ssh->ensurePythonYaml();
        $ssh2Installed = $ssh->isPackageInstalled('php-ssh2');

        $keyPair = $ssh->generateKeyPair();
        $ssh->setupSshKey($keyPair['public']);

        $stmt = $pdo->prepare("UPDATE servers SET ssh_private_key=?, ssh_public_key=?, ssh_configured=TRUE WHERE id=?");
        $stmt->execute([$keyPair['private'], $keyPair['public'], $serverId]);

        $msg = "SSH настроен. Ключ сгенерирован.";
        if ($pyResult['success']) {
            $msg .= " python3-yaml готов.";
        } else {
            $msg .= " ВНИМАНИЕ: " . $pyResult['message'];
        }
        $msg .= " php-ssh2 на удалённом сервере: " . ($ssh2Installed ? 'да' : 'нет');

        return ['success' => true, 'message' => $msg];
    }

    public static function addIpv6(int $serverId, string $ipv6, string $interface = ''): array
    {
        $server = Database::getServer($serverId);
        if (!$server) throw new Exception('Сервер не найден');
