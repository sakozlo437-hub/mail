<?php
// src/StalwartClient.php

class StalwartClient
{
    private string $apiUrl;
    private string $username;
    private string $password;

    public function __construct(string $apiUrl, string $username, string $password)
    {
        $this->apiUrl = rtrim($apiUrl, '/') . '/jmap';
        $this->username = $username;
        $this->password = $password;
    }

    private function request(array $methodCalls, array $using = []): array
    {
        $defaultUsing = ['urn:ietf:params:jmap:core', 'urn:stalwart:jmap'];
        $using = array_unique(array_merge($defaultUsing, $using));

        $payload = [
            'using' => array_values($using),
            'methodCalls' => $methodCalls,
        ];

        $ch = curl_init($this->apiUrl);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => json_encode($payload),
            CURLOPT_HTTPHEADER => ['Content-Type: application/json'],
            CURLOPT_USERPWD => $this->username . ':' . $this->password,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_TIMEOUT => 30,
        ]);

        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $error = curl_error($ch);
        curl_close($ch);

        if ($error) {
            throw new Exception("cURL error: $error");
        }
        if ($httpCode !== 200) {
            throw new Exception("JMAP HTTP error $httpCode: $response");
        }

        $data = json_decode($response, true);
        if (!isset($data['methodResponses'])) {
            throw new Exception("Invalid JMAP response: $response");
        }
        return $data;
    }

    public function testConnection(): array
    {
        try {
            $response = $this->request([
                ['Core/echo', ['hello' => 'world'], 'c1']
            ]);
            foreach ($response['methodResponses'] as $method) {
                if ($method[0] === 'Core/echo') {
                    return ['success' => true, 'message' => 'Соединение установлено, JMAP работает'];
                }
            }
            return ['success' => false, 'message' => 'Неожиданный ответ сервера'];
        } catch (Exception $e) {
            return ['success' => false, 'message' => $e->getMessage()];
        }
    }

    public function getDomains(): array
    {
        $response = $this->request([
            ['x:Domain/get', ['ids' => null], 'c1']
        ]);
        $domains = [];
        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:Domain/get' && isset($method[1]['list'])) {
                foreach ($method[1]['list'] as $domain) {
                    $domains[$domain['name']] = $domain['id'];
                }
            }
        }
        return $domains;
    }

    public function getDomainIdByName(string $name): ?string
    {
        $domains = $this->getDomains();
        return $domains[$name] ?? null;
    }

    public function createDomain(string $domainName): ?string
    {
        $response = $this->request([
            ['x:Domain/set', [
                'create' => [
                    'new1' => [
                        '@type' => 'Domain',
                        'name' => $domainName,
                    ]
                ]
            ], 'c1']
        ]);
        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:Domain/set') {
                if (isset($method[1]['created']['new1']['id'])) {
                    return $method[1]['created']['new1']['id'];
                }
                if (isset($method[1]['notCreated']['new1'])) {
                    throw new Exception("Ошибка создания домена: " . json_encode($method[1]['notCreated']['new1']));
                }
            }
        }
        return null;
    }

    public function deleteDomain(string $domainId): bool
    {
        $destroy = ['destroy' => [$domainId]];
        $response = $this->request([
            ['x:Domain/set', $destroy, 'c1']
        ]);
        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:Domain/set') {
                if (isset($method[1]['notDestroyed'][$domainId])) {
                    throw new Exception("Ошибка удаления домена: " . json_encode($method[1]['notDestroyed'][$domainId]));
                }
                return true;
            }
        }
        return false;
    }

    public function createAccount(string $localPart, string $domainId, string $password): bool
    {
        $credential = new stdClass();
        $credential->{'@type'} = 'Password';
        $credential->secret = $password;

        $credentials = new stdClass();
        $credentials->{'0'} = $credential;

        $roles = new stdClass();
        $roles->{'@type'} = 'User';

        $permissions = new stdClass();
        $permissions->{'@type'} = 'Inherit';

        $account = new stdClass();
        $account->{'@type'} = 'User';
        $account->name = $localPart;
        $account->domainId = $domainId;
        $account->credentials = $credentials;
        $account->roles = $roles;
        $account->permissions = $permissions;

        $create = new stdClass();
        $create->new1 = $account;

        $response = $this->request([
            ['x:Account/set', [
                'create' => $create
            ], 'c1']
        ]);

        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:Account/set') {
                if (isset($method[1]['notCreated']['new1'])) {
                    throw new Exception("Ошибка создания аккаунта: " . json_encode($method[1]['notCreated']['new1']));
                }
                return true;
            }
        }
        return false;
    }

    public function deleteAccount(string $accountId): bool
    {
        $destroy = ['destroy' => [$accountId]];
        $response = $this->request([
            ['x:Account/set', $destroy, 'c1']
        ]);
        foreach ($response['methodResponses'] as $method) {
