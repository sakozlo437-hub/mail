            $server['ssh_user'],
            $server['ssh_password']
        );
        $ssh->connect();

        return $ssh->addIpv6($ipv6, $interface);
    }

    /**
     * Удалить IPv6-адрес с сервера Stalwart через SSH.
     */
    public static function removeIpv6(int $serverId, string $ipv6, string $interface = ''): array
    {
        $server = Database::getServer($serverId);
        if (!$server) throw new Exception('Сервер не найден');
        if (empty($server['ssh_host'])) throw new Exception('SSH не настроен');

        $ssh = new SshClient(
            $server['ssh_host'],
            (int)$server['ssh_port'],
            $server['ssh_user'],
            $server['ssh_password']
        );
        $ssh->connect();

        return $ssh->removeIpv6($ipv6, $interface ?: 'eth0');
    }

    /**
     * Получить домены, привязанные к IP.
     */
    public static function getDomainsByIpForServer(int $serverId, string $ip): array
    {
