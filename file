                    throw new Exception("Ошибка удаления правила: " . json_encode($method[1]['notUpdated']['singleton']));
                }
                return true;
            }
        }
        return false;
    }

    /**
     * Найти Connection Strategy по имени.
     */
    public function findStrategyByName(string $name): ?array
    {
        $strategies = $this->getConnectionStrategies();
        foreach ($strategies as $st) {
            if ($st['name'] === $name) {
                return $st;
            }
        }
        return null;
    }

    /**
     * Получить список всех ACME-провайдеров.
     */
    public function getAcmeProviders(): array
    {
        try {
            $response = $this->request([
                ['x:AcmeProvider/get', ['ids' => null], 'c1']
            ]);
            $providers = [];
            foreach ($response['methodResponses'] as $method) {
                if ($method[0] === 'x:AcmeProvider/get' && isset($method[1]['list'])) {
                    foreach ($method[1]['list'] as $p) {
                        $providers[] = [
                            'id' => $p['id'] ?? '',
                            'directory' => $p['directory'] ?? '',
                            'challengeType' => $p['challengeType'] ?? '',
                            'contact' => $p['contact'] ?? [],
                        ];
                    }
                }
            }
            return $providers;
        } catch (Exception $e) {
            return [];
        }
    }

    public function applySnapshot(string $ndjson): array
    {
        $log = [];
        $lines = explode("\n", $ndjson);
        $upserts = [];
        $updates = [];

        foreach ($lines as $line) {
            $line = trim($line);
            if (empty($line)) continue;
            $obj = json_decode($line, true);
            if ($obj === null) continue;
            $type = $obj['@type'] ?? '';
            $object = $obj['object'] ?? '';
            if ($type === 'upsert') {
                if (!isset($upserts[$object])) $upserts[$object] = [];
                $upserts[$object][] = $obj['value'] ?? [];
            } elseif ($type === 'update') {
                if (!isset($updates[$object])) $updates[$object] = [];
                $updates[$object][] = $obj['value'] ?? [];
            }
        }

        foreach ($upserts as $object => $values) {
            try {
                $method = 'x:' . $object . '/set';
                $create = new stdClass();
                $i = 0;
                foreach ($values as $value) {
                    $obj = new stdClass();
                    foreach ($value as $k => $v) {
                        if (is_string($v) && strpos($v, '#') === 0) continue;
                        $obj->{$k} = $v;
                    }
                    $create->{'new' . $i} = $obj;
                    $i++;
                }
                $this->request([[$method, ['create' => $create], 'c1']]);
                $log[] = "OK: {$object} ({$i})";
            } catch (Exception $e) {
                $log[] = "ERR: {$object}: " . $e->getMessage();
            }
        }

        foreach ($updates as $object => $values) {
            try {
                $method = 'x:' . $object . '/set';
                $update = new stdClass();
                $patch = new stdClass();
                foreach ($values as $value) {
                    foreach ($value as $k => $v) {
                        if (is_string($v) && strpos($v, '#') === 0) continue;
                        $patch->{$k} = $v;
                    }
                }
                $update->{'singleton'} = $patch;
                $this->request([[$method, ['update' => $update], 'c1']]);
                $log[] = "OK: {$object} (singleton)";
            } catch (Exception $e) {
                $log[] = "ERR: {$object}: " . $e->getMessage();
            }
        }

        return $log;
    }
}


