    /**
     * Удалить IP из Connection Strategy.
     * Читает текущую стратегию, убирает IP из sourceIps, обновляет.
     */
        public function removeIpFromConnectionStrategy(string $strategyId, string $ipToRemove): bool
    {
        $response = $this->request([
            ['x:MtaConnectionStrategy/get', ['ids' => [$strategyId]], 'c1']
        ]);

        $strategy = null;
        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:MtaConnectionStrategy/get' && isset($method[1]['list'][0])) {
                $strategy = $method[1]['list'][0];
            }
        }

        if (!$strategy) {
            throw new Exception("Стратегия с ID {$strategyId} не найдена");
        }

        // Собираем новые sourceIps как stdClass (Map), а не массив
        $newIps = new stdClass();
        $i = 0;
        if (!empty($strategy['sourceIps']) && is_array($strategy['sourceIps'])) {
            foreach ($strategy['sourceIps'] as $key => $ipEntry) {
                $currentIp = '';
                if (is_array($ipEntry)) {
                    $currentIp = $ipEntry['sourceIp'] ?? '';
                } elseif (is_string($ipEntry)) {
                    $currentIp = $ipEntry;
                }

                if ($currentIp !== $ipToRemove) {
                    // Каждый элемент тоже должен быть stdClass, а не массив
                    if (is_array($ipEntry)) {
                        $obj = new stdClass();
                        foreach ($ipEntry as $k => $v) {
                            $obj->{$k} = $v;
                        }
                        $newIps->{(string)$i} = $obj;
                    } else {
                        $newIps->{(string)$i} = $ipEntry;
                    }
                    $i++;
                }
            }
        }

        $update = new stdClass();
        $patch = new stdClass();
        $patch->sourceIps = $newIps;
        $update->{$strategyId} = $patch;

        $response = $this->request([
            ['x:MtaConnectionStrategy/set', ['update' => $update], 'c1']
        ]);

        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:MtaConnectionStrategy/set') {
                if (isset($method[1]['notUpdated'][$strategyId])) {
                    throw new Exception("Ошибка удаления IP: " . json_encode($method[1]['notUpdated'][$strategyId]));
                }
                return true;
            }
        }
        return false;
    }

