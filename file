    /**
     * Создать DKIM-подпись.
     * $domainId — ID домена
     * $privateKey — PEM-encoded приватный ключ
     * $algorithm — 'rsa' или 'ed25519'
     * $selector — селектор (если null, генерируется автоматически)
     */
    public function createDkimSignature(string $domainId, string $privateKey, string $algorithm = 'rsa', ?string $selector = null): ?string
    {
        if (!$selector) {
            $date = date('Ymd');
            $selector = 'v1-' . $algorithm . '-' . $date;
        }

        $type = ($algorithm === 'ed25519') ? 'Dkim1Ed25519Sha256' : 'Dkim1RsaSha256';

        $keyObj = new stdClass();
        $keyObj->{'@type'} = 'Text';
        $keyObj->secret = $privateKey;

        $sig = new stdClass();
        $sig->{'@type'} = $type;
        $sig->domainId = $domainId;
        $sig->selector = $selector;
        $sig->privateKey = $keyObj;

        $sig->canonicalization = 'relaxed/relaxed';

        $create = new stdClass();
        $create->new1 = $sig;

        $response = $this->request([
            ['x:DkimSignature/set', ['create' => $create], 'c1']
        ]);

        foreach ($response['methodResponses'] as $method) {
            if ($method[0] === 'x:DkimSignature/set') {
                if (isset($method[1]['created']['new1']['id'])) {
                    return $method[1]['created']['new1']['id'];
                }
                if (isset($method[1]['notCreated']['new1'])) {
                    throw new Exception("Ошибка создания DKIM: " . json_encode($method[1]['notCreated']['new1']));
                }
            }
        }
        return null;
    }

    /**
     * Найти домены, привязанные к указанному IP.
     * Логика: IP → Connection Strategy → правила в Outbound Strategy → домены.
     */
    public function getDomainsByIp(string $ip): array
    {
        // 1. Находим все стратегии, где в sourceIps есть этот IP
        $strategies = $this->getConnectionStrategies();
        $strategyNames = [];
        foreach ($strategies as $st) {
            foreach ($st['sourceIps'] as $ipEntry) {
                if ($ipEntry['ip'] === $ip) {
                    $strategyNames[] = $st['name'];
                    break;
                }
            }
        }

        if (empty($strategyNames)) {
            return [];
        }

        // 2. Читаем Outbound Strategy и ищем правила для этих стратегий
        $outbound = $this->getOutboundStrategy();
        if (!$outbound || empty($outbound['connection']['match'])) {
            return [];
        }

        $domains = [];
        foreach ($outbound['connection']['match'] as $rule) {
            $ifExpr = $rule['if'] ?? '';
            $thenExpr = $rule['then'] ?? '';

            // Ищем sender_domain == 'X'
            if (preg_match("/sender_domain\s*==\s*'([^']+)'/", $ifExpr, $m)) {
                $domain = $m[1];
                // Проверяем, что стратегия в then — из нашего списка
                $thenName = trim($thenExpr, "'\"");
                if (in_array($thenName, $strategyNames)) {
                    $domains[] = $domain;
                }
            }
        }

        return $domains;
    }

