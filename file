<?php

class Database
{
    private static ?PDO $pdo = null;

    public static function get(): PDO
    {
        if (self::$pdo === null) {
            $config = require __DIR__ . '/../config/config.php';
            $db = $config['db'];
            $dsn = "pgsql:host={$db['host']};dbname={$db['dbname']}";
            self::$pdo = new PDO($dsn, $db['user'], $db['password'], [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            ]);
        }
        return self::$pdo;
    }

    public static function getAllServers(): array
    {
        return self::get()->query("SELECT * FROM servers ORDER BY id DESC")->fetchAll();
    }

    public static function addServer(string $name, string $apiUrl, string $apiUser, string $apiPassword): bool
    {
        $stmt = self::get()->prepare(
            "INSERT INTO servers (name, api_url, api_user, api_password) VALUES (?, ?, ?, ?)"
        );
        return $stmt->execute([$name, $apiUrl, $apiUser, $apiPassword]);
    }

    public static function deleteServer(int $id): bool
    {
        $stmt = self::get()->prepare("DELETE FROM servers WHERE id = ?");
        return $stmt->execute([$id]);
    }

    public static function getServer(int $id): ?array
    {
        $stmt = self::get()->prepare("SELECT * FROM servers WHERE id = ?");
        $stmt->execute([$id]);
        $row = $stmt->fetch();
        return $row ?: null;
    }

    public static function setPrimaryServer(int $id): bool
    {
        $pdo = self::get();
        $pdo->exec("UPDATE servers SET is_primary = FALSE");
        $stmt = $pdo->prepare("UPDATE servers SET is_primary = TRUE WHERE id = ?");
        return $stmt->execute([$id]);
    }

    public static function getPrimaryServer(): ?array
    {
        $row = self::get()->query("SELECT * FROM servers WHERE is_primary = TRUE LIMIT 1")->fetch();
        return $row ?: null;
    }
}


