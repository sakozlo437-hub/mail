     * Возвращает ['success' => bool, 'message' => string]
     */
    public function ensurePythonYaml(): array
    {
        // 1. Проверяем, есть ли python3
        $py = $this->exec("which python3 2>/dev/null");
        if (empty(trim($py['output']))) {
            // Устанавливаем python3
            $this->exec("apt update 2>&1");
            $this->exec("apt install -y python3 2>&1");
        }

        // 2. Проверяем, есть ли модуль yaml
        $check = $this->exec("python3 -c 'import yaml' 2>&1");
        if (strpos($check['output'], 'Error') !== false || strpos($check['output'], 'Traceback') !== false || strpos($check['output'], 'No module named') !== false) {
            // Устанавливаем python3-yaml
            $install = $this->exec("apt update 2>&1 && apt install -y python3-yaml 2>&1");
            // Проверяем ещё раз
            $verify = $this->exec("python3 -c 'import yaml; print(\"OK\")' 2>&1");
            if (strpos($verify['output'], 'OK') === false) {
                return [
                    'success' => false,
                    'message' => 'Не удалось установить python3-yaml: ' . $install['output']
                ];
            }
        }

        return ['success' => true, 'message' => 'python3 и yaml готовы'];
    }
    public function generateKeyPair(): array
    {
        $this->exec("mkdir -p /root/.ssh && chmod 700 /root/.ssh");
        $this->exec("rm -f /root/.ssh/id_ed25519_panel /root/.ssh/id_ed25519_panel.pub");
        $this->exec("ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519_panel -N '' -q");
        $pub = $this->exec("cat /root/.ssh/id_ed25519_panel.pub");
        $priv = $this->exec("cat /root/.ssh/id_ed25519_panel");
        return [
            'public' => trim($pub['output']),
            'private' => trim($priv['output']),
        ];
    }

    public function setupSshKey(string $publicKey): void
    {
        $this->exec("mkdir -p /root/.ssh && chmod 700 /root/.ssh");
        $this->exec("grep -qF '{$publicKey}' /root/.ssh/authorized_keys 2>/dev/null || echo '{$publicKey}' >> /root/.ssh/authorized_keys");
        $this->exec("chmod 600 /root/.ssh/authorized_keys");
    }

    /**
     * Автоматически определяет интерфейс, находит секцию addresses,
     * добавляет новый IPv6, проверяет YAML и применяет через netplan apply.
     * При ошибке — откатывает из бэкапа.
     */
    public function addIpv6(string $ipv6, string $interface = ''): array
    {
        // 1. Определяем интерфейс, если не указан
        if (empty($interface)) {
            $ifaceResult = $this->exec("ip -o link show | awk -F': ' '{print \$2}' | grep -v lo | head -1");
            $interface = trim($ifaceResult['output']);
            if (empty($interface)) {
                return ['success' => false, 'message' => 'Не удалось определить сетевой интерфейс'];
            }
        }

        // 2. Нормализуем IPv6 (убираем /64, если он есть)
        $ipv6 = preg_replace('#/\d+$#', '', $ipv6);
        $fullIp = $ipv6 . '/64';

        // 3. Бэкап с временной меткой
        $backup = "/root/netplan-backup-" . date('Ymd_His') . ".yaml";
        $this->exec("cp /etc/netplan/50-cloud-init.yaml {$backup} 2>/dev/null");

        // 4. Проверяем, есть ли уже IP на интерфейсе
        $check = $this->exec("ip -6 addr show {$interface} | grep -F '{$ipv6}'");
        if (!empty(trim($check['output']))) {
            return ['success' => true, 'message' => "IP {$ipv6} уже настроен на {$interface}"];
        }

        // 5. Читаем текущий Netplan
        $current = $this->exec("cat /etc/netplan/50-cloud-init.yaml");
        $yaml = $current['output'];

        // 6. Если IP уже есть в файле — просто применяем
        if (strpos($yaml, $fullIp) !== false || strpos($yaml, $ipv6) !== false) {
            $this->exec("netplan apply 2>&1");
            return ['success' => true, 'message' => "IP {$fullIp} уже в Netplan, применён"];
        }

        // 7. Ищем секцию addresses и добавляем новый IP в том же формате
        $lines = explode("\n", $yaml);
        $newLines = [];
        $inserted = false;
        $inAddresses = false;
        $addressesIndent = '';
        $lastAddressLineIndex = -1;

        foreach ($lines as $i => $line) {
            // Определяем, что мы вошли в секцию addresses
            if (preg_match('/^(\s*)addresses:\s*$/', $line, $m)) {
                $inAddresses = true;
                $addressesIndent = $m[1];
                $newLines[] = $line;
                continue;
            }

            // Если мы в секции addresses и встретили строку с IP
            if ($inAddresses && preg_match('/^(\s*-\s*["\']?)([\d\.:a-fA-F]+)(\/\d+)?(["\']?)\s*$/', $line, $m)) {
                $newLines[] = $line;
                $lastAddressLineIndex = count($newLines) - 1;

                // Если это IPv6 из того же диапазона — запоминаем, что тут можно вставить
                continue;
            }

            // Если мы в секции addresses и встретили не-IP строку — выходим из секции
            if ($inAddresses && !preg_match('/^\s*(-|#)/', $line) && trim($line) !== '') {
                // Вставляем новый IP перед этой строкой, если ещё не вставили
                if (!$inserted && $lastAddressLineIndex >= 0) {
                    $indent = '      ';
                    $newLines[] = $indent . '- "' . $fullIp . '"';
                    $inserted = true;
                }
                $inAddresses = false;
            }

            $newLines[] = $line;
        }

        // Если дошли до конца файла и не вставили — вставляем после последней строки addresses
        if (!$inserted && $lastAddressLineIndex >= 0) {
            $indent = '      ';
            array_splice($newLines, $lastAddressLineIndex + 1, 0, [$indent . '- "' . $fullIp . '"']);
            $inserted = true;
        }

        if (!$inserted) {
            return ['success' => false, 'message' => 'Не удалось найти секцию addresses в Netplan'];
        }

        $newYaml = implode("\n", $newLines);

        // 8. Проверяем YAML через Python (yaml.safe_load)
        $checkCmd = "python3 -c 'import yaml,sys; yaml.safe_load(open(\"/tmp/netplan-check.yaml\"))' 2>&1";
        $encoded = base64_encode($newYaml);
        $this->exec("echo '{$encoded}' | base64 -d > /tmp/netplan-check.yaml");
        $validate = $this->exec($checkCmd);

        if (strpos($validate['output'], 'Error') !== false || strpos($validate['output'], 'error') !== false || strpos($validate['output'], 'Traceback') !== false) {
            return ['success' => false, 'message' => 'YAML невалиден: ' . $validate['output']];
        }

        // 9. Записываем новый YAML
        $this->exec("echo '{$encoded}' | base64 -d > /etc/netplan/50-cloud-init.yaml");
        $this->exec("chmod 600 /etc/netplan/50-cloud-init.yaml");

        // 10. Применяем netplan
        $apply = $this->exec("netplan apply 2>&1");

        // 11. Проверяем, что IP появился
        $verify = $this->exec("ip -6 addr show {$interface} | grep -F '{$ipv6}'");

        if (empty(trim($verify['output']))) {
            // Откат
            $this->exec("cp {$backup} /etc/netplan/50-cloud-init.yaml");
            $this->exec("netplan apply 2>&1");
            return [
                'success' => false,
                'message' => "IP не появился. Откат выполнен. Ответ netplan: " . $apply['output']
            ];
        }

        return ['success' => true, 'message' => "IP {$fullIp} добавлен и активен на {$interface}"];
    }

    /**
     * Прочитать IPv6-адреса из Netplan.
     */
    public function getNetplanIps(string $interface = 'eth0'): array
    {
        $result = $this->exec("cat /etc/netplan/50-cloud-init.yaml 2>/dev/null");
        $yaml = $result['output'];
        if (empty(trim($yaml))) {
            return [];
        }

        $ips = [];
        $lines = explode("\n", $yaml);
        foreach ($lines as $line) {
            if (preg_match('/-\s*["\']?(2605:[\da-fA-F:]+)(\/\d+)?["\']?/', $line, $m)) {
                $ips[] = $m[1] . ($m[2] ?? '/64');
            }
        }
        return array_unique($ips);
    }

    /**
     * Удалить IPv6-адрес из Netplan.
     * Делает бэкап, удаляет строку с IP, применяет netplan apply.
     * При ошибке — откат из бэкапа.
     */
    public function removeIpv6(string $ipv6, string $interface = 'eth0'): array
    {
        // Нормализуем IP (убираем /64, если есть)
        $ipv6 = preg_replace('#/\d+$#', '', $ipv6);

        // Проверяем, есть ли IP на интерфейсе
        $check = $this->exec("ip -6 addr show {$interface} | grep -F '{$ipv6}'");
        if (empty(trim($check['output']))) {
            return ['success' => true, 'message' => "IP {$ipv6} уже отсутствует на {$interface}"];
        }

        // Бэкап
        $backup = "/root/netplan-backup-" . date('Ymd_His') . ".yaml";
        $this->exec("cp /etc/netplan/50-cloud-init.yaml {$backup} 2>/dev/null");

        // Читаем Netplan
        $current = $this->exec("cat /etc/netplan/50-cloud-init.yaml");
        $yaml = $current['output'];

        // Удаляем строку с IP
        $lines = explode("\n", $yaml);
        $newLines = [];
        $removed = false;

        foreach ($lines as $line) {
            // Пропускаем строки, содержащие удаляемый IP
            if (strpos($line, $ipv6) !== false) {
                $removed = true;
                continue;
            }
            $newLines[] = $line;
        }

        if (!$removed) {
            return ['success' => false, 'message' => "IP {$ipv6} не найден в Netplan"];
        }

        $newYaml = implode("\n", $newLines);

        // Проверяем YAML через Python
        $encoded = base64_encode($newYaml);
        $this->exec("echo '{$encoded}' | base64 -d > /tmp/netplan-check.yaml");
        $validate = $this->exec("python3 -c 'import yaml; yaml.safe_load(open(\"/tmp/netplan-check.yaml\"))' 2>&1");

        if (strpos($validate['output'], 'Error') !== false || strpos($validate['output'], 'Traceback') !== false) {
            return ['success' => false, 'message' => 'YAML невалиден: ' . $validate['output']];
        }

        // Записываем
        $this->exec("echo '{$encoded}' | base64 -d > /etc/netplan/50-cloud-init.yaml");
        $this->exec("chmod 600 /etc/netplan/50-cloud-init.yaml");

        // Применяем
        $apply = $this->exec("netplan apply 2>&1");

        // Проверяем, что IP исчез
        $verify = $this->exec("ip -6 addr show {$interface} | grep -F '{$ipv6}'");
