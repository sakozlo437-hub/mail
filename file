require_once __DIR__ . '/../vendor/autoload.php';

use phpseclib3\Net\SSH2;

class SshClient
{
    private ?SSH2 $ssh = null;
    private string $host;
    private int $port;
    private string $user;
    private ?string $password;

    private ?string $privateKey = null;

    public function __construct(string $host, int $port = 22, string $user = 'root', ?string $password = null, ?string $privateKey = null)
    {
        $this->host = $host;
        $this->port = $port;
        $this->user = $user;
        $this->password = $password;
        $this->privateKey = $privateKey;
    }

    public function connect(): bool
    {
        $this->ssh = new SSH2($this->host, $this->port);
        $this->ssh->setTimeout(120);

        // Сначала пробуем ключ
        if (!empty($this->privateKey)) {
            $key = \phpseclib3\Crypt\PublicKeyLoader::load($this->privateKey);
            if ($key && $this->ssh->login($this->user, $key)) {
                return true;
            }
        }

        // Потом пароль
        if (!empty($this->password)) {
            if ($this->ssh->login($this->user, $this->password)) {
                return true;
            }
        }

        throw new Exception("Не удалось аутентифицироваться на {$this->host}: " . $this->ssh->getLastError());
    }

    public function exec(string $command): array
    {
        if (!$this->ssh) {
            $this->connect();
        }
        $output = $this->ssh->exec($command);
        return ['output' => $output, 'error' => ''];
    }

    public function isPackageInstalled(string $package): bool
    {
        $result = $this->exec("dpkg -l {$package} 2>/dev/null | grep '^ii'");
        return !empty(trim($result['output']));
    }
