<?php

class SnapshotService
{
    /**
     * Сделать snapshot на сервере Stalwart и сохранить в БД.
     * $type = 'full' — полный (как есть), 'bare' — голый (без доменов/IP/DKIM/TLS).
     */
    public static function create(int $serverId, string $type = 'bare'): string
    {
        $server = Database::getServer($serverId);
        if (!$server) throw new Exception('Сервер не найден');
        if (empty($server['ssh_host'])) throw new Exception('SSH не настроен');

        $ssh = new SshClient(
            $server['ssh_host'],
            (int)$server['ssh_port'],
            $server['ssh_user'],
            $server['ssh_password']
        );
        $ssh->connect();

        $path = '/tmp/stalwart-snapshot-' . date('Ymd_His') . '.ndjson';
        $env = "STALWART_URL={$server['api_url']} STALWART_USER={$server['api_user']} STALWART_PASSWORD='" . $server['api_password'] . "'";

        if ($type === 'full') {
            // Полный snapshot — все объекты
            $objects = 'SystemSettings Domain DkimSignature Certificate MtaConnectionStrategy MtaRoute MtaDeliverySchedule MtaOutboundStrategy AcmeProvider Role Tenant';
            $allowUnresolved = '--allow-unresolved Directory,DnsServer,DnsResolver,MtaVirtualQueue,HttpLookup,BlockedIp,AllowedIp,ApiKey,AppPassword,Account,AccountPassword,AccountSettings,Bootstrap';
        } else {
            // Голый snapshot — только базовые настройки
            $objects = 'SystemSettings MtaRoute MtaDeliverySchedule MtaOutboundStrategy AcmeProvider Role Tenant';
            $allowUnresolved = '--allow-unresolved Directory,DnsServer,DnsResolver,MtaVirtualQueue,HttpLookup,BlockedIp,AllowedIp,ApiKey,AppPassword,Account,AccountPassword,AccountSettings,Bootstrap';
        }

        $cmd = "source /root/.cargo/env && {$env} stalwart-cli snapshot {$objects} {$allowUnresolved} --output {$path} 2>&1";

        $result = $ssh->exec($cmd);
        if (strpos($result['output'], 'error') !== false) {
            throw new Exception('Ошибка snapshot: ' . $result['output']);
        }

        $content = $ssh->exec("cat {$path}");
        if (empty(trim($content['output']))) {
            throw new Exception('Snapshot пустой');
        }

        // Для 'bare' — очищаем connection в MtaOutboundStrategy
        $lines = [];
        foreach (explode("\n", $content['output']) as $line) {
            $line = trim($line);
            if (empty($line)) continue;
            $obj = json_decode($line, true);
            if ($obj === null) continue;

            if ($type === 'bare'
                && ($obj['object'] ?? '') === 'MtaOutboundStrategy'
                && isset($obj['value']['connection']['match'])) {
                $obj['value']['connection'] = ['else' => "'default'"];
            }
            $lines[] = json_encode($obj, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        }

        $cleanSnapshot = implode("\n", $lines);

        // Сохраняем в БД
        $pdo = Database::get();
        if ($type === 'full') {
            $stmt = $pdo->prepare("UPDATE servers SET stalwart_snapshot_full = ?, snapshot_full_created_at = NOW() WHERE id = ?");
        } else {
            $stmt = $pdo->prepare("UPDATE servers SET stalwart_snapshot_bare = ?, snapshot_bare_created_at = NOW() WHERE id = ?");
        }
        $stmt->execute([$cleanSnapshot, $serverId]);

        $ssh->exec("rm -f {$path}");

        return $cleanSnapshot;
    }

    /**
     * Получить snapshot из БД.
     * $type = 'full' | 'bare'
     */
    public static function get(int $serverId, string $type = 'bare'): ?string
    {
        $pdo = Database::get();
        $column = ($type === 'full') ? 'stalwart_snapshot_full' : 'stalwart_snapshot_bare';
        $stmt = $pdo->prepare("SELECT {$column} FROM servers WHERE id = ?");
        $stmt->execute([$serverId]);
        $row = $stmt->fetch();
        return $row[$column] ?? null;
    }

    /**
     * Удалить snapshot из БД.
     */
    public static function delete(int $serverId, string $type = 'bare'): void
    {
        $pdo = Database::get();
        if ($type === 'full') {
            $stmt = $pdo->prepare("UPDATE servers SET stalwart_snapshot_full = NULL, snapshot_full_created_at = NULL WHERE id = ?");
        } else {
            $stmt = $pdo->prepare("UPDATE servers SET stalwart_snapshot_bare = NULL, snapshot_bare_created_at = NULL WHERE id = ?");
        }
        $stmt->execute([$serverId]);
    }

    /**
     * Развернуть Stalwart на новом сервере.
     */
    public static function deployStalwart(array $installData): array
    {
        // Ищем сервер по SSH-хосту для использования ключа
        $pdo = Database::get();
        $stmt = $pdo->prepare("SELECT * FROM servers WHERE ssh_host = ? LIMIT 1");
        $stmt->execute([$installData['ssh_host']]);
        $existingServer = $stmt->fetch();

        if ($existingServer && !empty($existingServer['ssh_private_key'])) {
            $ssh = new SshClient(
                $existingServer['ssh_host'],
                (int)$existingServer['ssh_port'],
                $existingServer['ssh_user'],
                $existingServer['ssh_password'],
                $existingServer['ssh_private_key']
            );
        } else {
            $ssh = new SshClient(
                $installData['ssh_host'],
                (int)$installData['ssh_port'],
                $installData['ssh_user'],
                $installData['ssh_password']
            );
        }
        $ssh->connect();

        $log = [];
        $fullLog = "=== Развёртывание Stalwart на {$installData['ssh_host']} ===\n";
        $fullLog .= "Начало: " . date('Y-m-d H:i:s') . "\n\n";

        $logLine = function($msg) use (&$log, &$fullLog) {
            $log[] = $msg;
            $fullLog .= "[" . date('H:i:s') . "] " . $msg . "\n";
        };

        // 1. apt update
        $logLine("apt update...");
        $ssh->exec("DEBIAN_FRONTEND=noninteractive apt-get update -y 2>&1");

        // 2. Зависимости
        $logLine("Установка зависимостей...");
        $ssh->exec("DEBIAN_FRONTEND=noninteractive apt-get install -y curl wget ca-certificates 2>&1");

        // 3. Создаём директории ДО запуска
        $logLine("Создание директорий /var/lib/stalwart и /etc/stalwart...");
        $ssh->exec("mkdir -p /var/lib/stalwart /etc/stalwart");

        // 4. Устанавливаем Stalwart (создаёт пользователя stalwart)
        $logLine("Скачивание install.sh...");
        $ssh->exec("curl --proto '=https' --tlsv1.2 -sSf https://get.stalw.art/install.sh -o /tmp/stalwart-install.sh 2>&1");
        $logLine("Установка Stalwart...");
        $ssh->exec("DEBIAN_FRONTEND=noninteractive sh /tmp/stalwart-install.sh /opt/stalwart 2>&1");

        // 5. ТЕПЕРЬ меняем владельца (пользователь stalwart уже создан)
        $logLine("Установка прав на директории...");
        $ssh->exec("chown -R stalwart:stalwart /var/lib/stalwart /etc/stalwart");
        $ssh->exec("chmod -R u+rwx /var/lib/stalwart /etc/stalwart");
        
        // Также для /opt/stalwart
        $ssh->exec("chown -R stalwart:stalwart /opt/stalwart 2>/dev/null || true");
        $logLine("Права установлены");

        // 4. Открываем порт 8080
        $logLine("Проверка порта 8080...");
        $ssh->exec("DEBIAN_FRONTEND=noninteractive apt-get install -y ufw 2>&1");
        $ssh->exec("ufw allow 8080/tcp 2>&1");
        $logLine("Порт 8080 открыт");

        // 5. Скачиваем установщик
        $logLine("Скачивание install.sh...");
        $ssh->exec("curl --proto '=https' --tlsv1.2 -sSf https://get.stalw.art/install.sh -o /tmp/stalwart-install.sh 2>&1");

        // 6. Устанавливаем Stalwart
        $logLine("Установка Stalwart...");
        $ssh->exec("DEBIAN_FRONTEND=noninteractive sh /tmp/stalwart-install.sh /opt/stalwart 2>&1");

        // 7. Включаем Recovery Mode
        $logLine("Включение Recovery Mode...");
        $ssh->exec("mkdir -p /opt/stalwart/etc");
        $ssh->exec("echo 'STALWART_RECOVERY_MODE=1' > /opt/stalwart/etc/stalwart.env");
        $logLine("Recovery Mode включён");

        // 8. Перезапускаем — генерируется пароль
        $logLine("Перезапуск сервиса...");
        $ssh->exec("systemctl restart stalwart 2>&1");
        sleep(8);

        // 9. Читаем пароль из логов
        $logLine("Чтение пароля из логов...");
        $logs = $ssh->exec("journalctl -u stalwart --since '1 minute ago' --no-pager | grep -A5 'bootstrap mode' | grep 'password:' | tail -1");
        $logOutput = trim($logs['output']);
        
        $tempPassword = '';
        if (preg_match('/password:\s*(\S+)/', $logOutput, $m)) {
            $tempPassword = $m[1];
            $logLine("Пароль найден: " . $tempPassword);
        } else {
            $logLine("⚠️ Пароль не найден в логах");
        }

        // 10. Сохраняем в БД
        if ($tempPassword && $existingServer) {
            $pdo = Database::get();
            $stmt = $pdo->prepare("UPDATE servers SET temp_admin_user = 'admin', temp_admin_password = ?, admin_url = ?, deploy_status = 'bootstrap' WHERE id = ?");
            $stmt->execute([$tempPassword, "http://{$installData['ssh_host']}:8080/admin", $existingServer['id']]);
        }

        // 11. Если передан snapshot — применяем
        if (!empty($installData['snapshot']) && $tempPassword) {
            $logLine("Загрузка snapshot...");
            $encoded = base64_encode($installData['snapshot']);
            $chunks = str_split($encoded, 4096);
            $ssh->exec("> /tmp/stalwart-snapshot.b64");
            foreach ($chunks as $chunk) {
                $ssh->exec("echo '{$chunk}' >> /tmp/stalwart-snapshot.b64");
            }
            $ssh->exec("base64 -d /tmp/stalwart-snapshot.b64 > /tmp/stalwart-snapshot.ndjson");
            
            // Применяем через JMAP API
            $logLine("Применение snapshot через JMAP API...");
            try {
                $client = new StalwartClient('http://' . $installData['ssh_host'] . ':8080', 'admin', $tempPassword);
                $test = $client->testConnection();
                if ($test['success']) {
                    $applyLog = $client->applySnapshot($installData['snapshot']);
                    foreach ($applyLog as $entry) {
                        $logLine($entry);
                    }
                } else {
                    $logLine("⚠️ API: " . $test['message']);
                }
            } catch (Exception $e) {
                $logLine("⚠️ Ошибка apply: " . $e->getMessage());
            }
        }

        // ВАЖНО: НЕ перезапускаем сервис после apply, чтобы пароль не изменился!
        $logLine("Развёртывание завершено. Recovery Mode остаётся включённым для ручного прохождения мастера.");

        $fullLog .= "\n=== Завершено: " . date('Y-m-d H:i:s') . " ===\n";

        // Сохраняем лог
        if ($existingServer) {
            $stmt = $pdo->prepare("UPDATE servers SET deploy_log = ?, deploy_started_at = ?, deploy_finished_at = NOW() WHERE id = ?");
            $stmt->execute([$fullLog, date('Y-m-d H:i:s'), $existingServer['id']]);
        }

        return [
            'success' => true,
            'admin_url' => "http://{$installData['ssh_host']}:8080/admin",
            'username' => 'admin',
            'password' => $tempPassword,
            'log' => $log,
            'full_log' => $fullLog,
        ];
    }

    /**
     * Завершить развёртывание: сохранить постоянный пароль, отключить Recovery Mode, перезапустить.
     */
    public static function finalizeDeploy(int $serverId, string $adminUser, string $adminPassword): array
